{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:athena:schemas:evolution:generation_request:v1",
  "title": "Athena Bounded Candidate Generation Request",
  "description": "Immutable request for an ordered subset of a pre-frozen finite template catalog. Runtime validation enforces cumulative M0 family limits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "protocol_id", "catalog_id", "catalog_version", "template_ids", "candidate_created_at_utc", "research_only"],
  "properties": {
    "schema_version": { "const": "athena.evolution.generation_request.v1" },
    "request_id": { "$ref": "#/$defs/contentId" },
    "protocol_id": { "$ref": "#/$defs/contentId" },
    "catalog_id": { "$ref": "#/$defs/contentId" },
    "catalog_version": { "type": "integer", "minimum": 1 },
    "template_ids": { "type": "array", "minItems": 1, "maxItems": 36, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" } },
    "candidate_created_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$", "description": "Must equal the locked protocol timestamp to make exact candidate bytes reproducible." },
    "research_only": { "const": true }
  },
  "$defs": { "contentId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
