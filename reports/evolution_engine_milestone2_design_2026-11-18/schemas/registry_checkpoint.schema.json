{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:athena:schemas:evolution:registry_checkpoint:v1",
  "title": "Athena Externally Signed Registry Checkpoint",
  "description": "Signed commitment to the exact registry event-chain tip. The latest checkpoint digest is pinned in a separate protected anchor store.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "registry_identity_sha256", "search_family_id", "protocol_id", "protocol_sha256", "catalog_freeze_receipt_sha256", "generation_manifest_sha256", "control_record_sha256", "checkpoint_sequence", "event_count", "event_tip_sha256", "attempt_manifest_sha256", "attempt_count", "previous_checkpoint_sha256", "created_at_utc", "signer_key_id", "signer_key_epoch", "signature_algorithm", "checkpoint_core_sha256", "checkpoint_sha256", "signature"],
  "properties": {
    "schema_version": { "const": "athena.evolution.registry_checkpoint.v1" },
    "registry_id": { "$ref": "#/$defs/contentId" },
    "registry_identity_sha256": { "$ref": "#/$defs/sha256" },
    "search_family_id": { "$ref": "#/$defs/contentId" },
    "protocol_id": { "$ref": "#/$defs/contentId" },
    "protocol_sha256": { "$ref": "#/$defs/sha256" },
    "catalog_freeze_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "generation_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "control_record_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "checkpoint_sequence": { "type": "integer", "minimum": 1 },
    "event_count": { "type": "integer", "minimum": 1 },
    "event_tip_sha256": { "$ref": "#/$defs/sha256" },
    "attempt_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "attempt_count": { "type": "integer", "minimum": 1, "maximum": 36 },
    "previous_checkpoint_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "created_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "signer_key_id": { "$ref": "#/$defs/sha256" },
    "signer_key_epoch": { "type": "integer", "minimum": 1 },
    "signature_algorithm": { "const": "Ed25519" },
    "checkpoint_core_sha256": { "$ref": "#/$defs/sha256" },
    "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
    "signature": { "type": "string", "contentEncoding": "base64", "minLength": 80, "maxLength": 100 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contentId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
