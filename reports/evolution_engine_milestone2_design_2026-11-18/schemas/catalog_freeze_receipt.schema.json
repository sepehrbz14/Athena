{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:athena:schemas:evolution:catalog_freeze_receipt:v1",
  "title": "Externally Trusted Frozen Catalog Receipt",
  "description": "An append-only external governance receipt proving that a reviewed catalog version was frozen before generation. It does not modify the frozen M0/M1 registry event schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "registry_identity_sha256", "search_family_id", "catalog_id", "catalog_version", "parent_catalog_id", "approved_content_sha256", "catalog_review_signature_sha256", "freeze_sequence", "previous_receipt_sha256", "frozen_at_utc", "identity_authority_key_id", "signature_algorithm", "signature"],
  "properties": {
    "schema_version": { "const": "athena.evolution.catalog_freeze_receipt.v1" },
    "registry_id": { "$ref": "#/$defs/contentId" },
    "registry_identity_sha256": { "$ref": "#/$defs/sha256" },
    "search_family_id": { "$ref": "#/$defs/contentId" },
    "catalog_id": { "$ref": "#/$defs/contentId" },
    "catalog_version": { "type": "integer", "minimum": 1 },
    "parent_catalog_id": { "oneOf": [{ "$ref": "#/$defs/contentId" }, { "type": "null" }] },
    "approved_content_sha256": { "$ref": "#/$defs/sha256" },
    "catalog_review_signature_sha256": { "$ref": "#/$defs/sha256" },
    "freeze_sequence": { "type": "integer", "minimum": 1 },
    "previous_receipt_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "frozen_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "identity_authority_key_id": { "$ref": "#/$defs/sha256" },
    "signature_algorithm": { "const": "Ed25519" },
    "signature": { "type": "string", "contentEncoding": "base64", "minLength": 80, "maxLength": 100 }
  },
  "allOf": [
    {
      "if": { "properties": { "catalog_version": { "const": 1 } }, "required": ["catalog_version"] },
      "then": { "properties": { "parent_catalog_id": { "type": "null" }, "previous_receipt_sha256": { "type": "null" } } },
      "else": { "properties": { "parent_catalog_id": { "$ref": "#/$defs/contentId" }, "previous_receipt_sha256": { "$ref": "#/$defs/sha256" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contentId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
