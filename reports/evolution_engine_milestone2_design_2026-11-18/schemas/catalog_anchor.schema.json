{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:athena:schemas:evolution:catalog_anchor:v1",
  "title": "Protected Latest Frozen Catalog Anchor",
  "description": "Externally protected monotonic pointer to the latest catalog freeze receipt for a registry/search family.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "registry_identity_sha256", "search_family_id", "freeze_sequence", "receipt_sha256", "anchor_revision"],
  "properties": {
    "schema_version": { "const": "athena.evolution.catalog_anchor.v1" },
    "registry_id": { "$ref": "#/$defs/contentId" },
    "registry_identity_sha256": { "$ref": "#/$defs/sha256" },
    "search_family_id": { "$ref": "#/$defs/contentId" },
    "freeze_sequence": { "type": "integer", "minimum": 1 },
    "receipt_sha256": { "$ref": "#/$defs/sha256" },
    "anchor_revision": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contentId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
