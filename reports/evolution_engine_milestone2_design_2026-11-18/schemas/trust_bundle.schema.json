{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:athena:schemas:evolution:trust_bundle:v1",
  "title": "External Public Trust Bundle",
  "description": "Public keys and role assignments pinned outside the repository and registry database. Contains no private keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity_authority", "initial_checkpoint_signer", "catalog_reviewers", "custodians"],
  "properties": {
    "schema_version": { "const": "athena.evolution.trust_bundle.v1" },
    "identity_authority": { "$ref": "#/$defs/trustedKey" },
    "initial_checkpoint_signer": { "$ref": "#/$defs/trustedKey" },
    "catalog_reviewers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/trustedKey" } },
    "custodians": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/trustedKey" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trustedKey": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "public_key_base64"],
      "properties": {
        "key_id": { "$ref": "#/$defs/sha256" },
        "public_key_base64": { "type": "string", "contentEncoding": "base64", "minLength": 40, "maxLength": 64 }
      }
    }
  }
}
