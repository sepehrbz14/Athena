{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.invalid/schemas/athena_m0_bonferroni_bound_amendment_v1.schema.json",
  "title": "Athena M0 full-family Bonferroni bound amendment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "amendment_id", "status", "base_protocol", "family_scope", "marginal_p_value", "holm_stepdown", "simultaneous_lower_bounds", "sample_and_placeholder_rules", "constants", "qualification_gate"],
  "properties": {
    "schema_version": {"const": "athena.evolution.m0-bonferroni-bound-amendment.v1"},
    "amendment_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"const": "PROPOSED_FOR_PROTOCOL_OWNER_APPROVAL"},
    "base_protocol": {"type": "object", "additionalProperties": false, "required": ["specification_id", "version", "preserved_source_path"], "properties": {"specification_id": {"const": "athena.evolution.m0-frozen.v1"}, "version": {"const": 1}, "preserved_source_path": {"const": "reports/evolution_engine_milestone0_2026-11-18/frozen_protocol.md"}}},
    "family_scope": {"type": "object", "additionalProperties": false, "required": ["attempt_accounting", "hypotheses_per_attempt", "maximum_hypotheses", "alpha"], "properties": {"attempt_accounting": {"const": "all_persistent_registered_attempts_including_invalid_failed_skipped_insufficient_and_unevaluated"}, "hypotheses_per_attempt": {"const": 4}, "maximum_hypotheses": {"const": 144}, "alpha": {"const": 0.05}}},
    "marginal_p_value": {"type": "object", "additionalProperties": false, "required": ["null", "formula", "comparison", "plus_one_correction", "bootstrap_error_definition", "monotonicity"], "properties": {"null": {"const": "H_i(delta): theta_i <= delta"}, "formula": {"const": "p_i(delta)=(1+sum_b I[e_ib>=theta_hat_i-delta])/(B+1)"}, "comparison": {"const": ">="}, "plus_one_correction": {"const": true}, "bootstrap_error_definition": {"const": "e_ib=theta_star_ib-theta_hat_i"}, "monotonicity": {"const": "nondecreasing_in_delta"}}},
    "holm_stepdown": {"type": "object", "additionalProperties": false, "required": ["family", "sort_order", "critical_value", "adjusted_p_value", "ties", "stopping_rule"], "properties": {"family": {"const": "all_four_hypotheses_for_every_persistent_family_attempt"}, "sort_order": {"const": "ascending_raw_p_then_global_attempt_ordinal_then_frozen_hypothesis_order"}, "critical_value": {"const": "alpha/(m-r+1), ranks_are_one_based"}, "adjusted_p_value": {"const": "p_adj_(r)=min(1,max_{s<=r}((m-s+1)*p_(s)))"}, "ties": {"const": "stable_by_global_attempt_ordinal_then_frozen_hypothesis_order"}, "stopping_rule": {"const": "reject_in_order_through_first_failure_and_stop"}}},
    "simultaneous_lower_bounds": {"type": "object", "additionalProperties": false, "required": ["method", "marginal_inverse", "marginal_level", "coverage_interpretation", "holm_separation"], "properties": {"method": {"const": "full_family_single_step_Bonferroni_simultaneous_lower_bounds"}, "marginal_inverse": {"const": "q_i(gamma)=sup{delta:p_i(delta)<=gamma}; use right_continuous_plus_one_p_function"}, "marginal_level": {"const": "gamma=alpha/m, where m is all four hypotheses for every registered persistent-family attempt"}, "coverage_interpretation": {"const": "simultaneous_1-alpha_coverage_by_union_bound_if_each_marginal_bootstrap_test_is_valid; arbitrary dependence allowed"}, "holm_separation": {"const": "Holm_adjusted_p_values_are_retained_for_family_testing_and_do_not_define_numeric_bounds"}}},
    "sample_and_placeholder_rules": {"type": "object", "additionalProperties": false, "required": ["sample_floors", "unresolved_attempts", "p1_function", "p1_bound"], "properties": {"sample_floors": {"const": "unchanged_frozen_M0_floors; below_floor_attempt_remains_four_p1_placeholders"}, "unresolved_attempts": {"const": "each_of_four_hypotheses_is_p1_and_remains_in_m"}, "p1_function": {"const": "p_i(delta)=1_for_all_finite_delta"}, "p1_bound": {"const": "null_no_finite_confidence_bound"}}},
    "constants": {"type": "object", "additionalProperties": false, "required": ["bootstrap_replicates", "moving_block_weeks", "ci_level", "master_seed", "alpha", "family_attempt_limit"], "properties": {"bootstrap_replicates": {"const": 100000}, "moving_block_weeks": {"const": 4}, "ci_level": {"const": 0.95}, "master_seed": {"const": 20261118}, "alpha": {"const": 0.05}, "family_attempt_limit": {"const": 36}}},
    "qualification_gate": {"type": "object", "additionalProperties": false, "required": ["status", "required_executable_hypotheses", "strict_positive_bound", "protocol_owner_approval_required"], "properties": {"status": {"const": "DISABLED_UNTIL_EXPLICIT_AMENDMENT_APPROVAL"}, "required_executable_hypotheses": {"const": ["robust_executable_absolute_weekly_return", "executable_paired_weekly_delta"]}, "strict_positive_bound": {"const": true}, "protocol_owner_approval_required": {"const": true}}}
  }
}
