{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.invalid/schemas/athena_frozen_signal_capture_metadata_v1.schema.json",
  "title": "Athena frozen signal capture metadata v1",
  "description": "Versioned validation view over the existing immutable signal-capture run metadata. Unknown provenance and diagnostic fields are retained but never interpreted as signals.",
  "type": "object",
  "required": ["signals", "candles"],
  "properties": {
    "signals": {"type": "integer", "minimum": 0},
    "candles": {"type": "integer", "minimum": 1},
    "signals_per_strategy": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "source": {"type": "string"},
    "policy": {"type": "string"},
    "capture_seconds": {"type": "number", "minimum": 0},
    "load_seconds": {"type": "number", "minimum": 0},
    "total_seconds": {"type": "number", "minimum": 0},
    "gap_rows": {"type": "integer", "minimum": 0},
    "gap_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}}
  },
  "additionalProperties": true
}
